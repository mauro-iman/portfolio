{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "film",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "5190", "--bind", "127.0.0.1", "--directory", "launch/film"],
      "port": 5190
    },
    {
      "name": "explorations",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5178",
        "--bind",
        "127.0.0.1",
        "--directory",
        "explorations"
      ],
      "port": 5178
    },
    {
      "name": "site",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "4321",
        "--host",
        "127.0.0.1"
      ],
      "port": 4321
    },
    {
      "name": "dist",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--",
        "--port",
        "4330",
        "--host",
        "127.0.0.1"
      ],
      "port": 4330
    },
    {
      "name": "video",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "launch/video",
        "run",
        "studio",
        "--",
        "--port",
        "3011",
        "--no-open"
      ],
      "port": 3011
