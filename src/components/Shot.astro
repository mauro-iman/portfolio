---
/* Drawn placeholder for a case cover, until real screenshots replace it. */
const { kind } = Astro.props;
---
{kind === 'compass' && <div class="shot" aria-hidden="true"><div class="sb"><i></i><i></i><i></i><i></i><i></i></div><div class="ct"><div class="bar"></div><div class="kp"><div></div><div></div><div></div></div><div class="row"><span></span><span></span><span></span><em></em></div><div class="row"><span></span><span></span><span></span><em></em></div><div class="row"><span></span><span></span><span></span><em></em></div><div class="row"><span></span><span></span><span></span><em></em></div></div></div>}
{kind === 'ypf' && <div class="shot" aria-hidden="true"><div class="sb"><i></i><i></i><i></i><i></i></div><div class="ct"><div class="bar"></div><svg viewBox="0 0 300 170" fill="none"><path d="M10 140 C 60 120, 70 60, 120 70 S 200 120, 230 60 S 280 30, 292 20" stroke="var(--line)" stroke-width="10" stroke-linecap="round"/><path d="M10 40 C 80 50, 120 20, 170 40 S 250 140, 292 150" stroke="var(--line)" stroke-width="6" stroke-linecap="round"/><path d="M20 135 C 60 118, 72 64, 120 72 S 200 118, 228 64" stroke="var(--fill)" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="1 7"/><circle cx="20" cy="135" r="6" fill="var(--fill)"/><circle cx="228" cy="64" r="6" fill="var(--paper)" stroke="var(--fill)" stroke-width="2.5"/></svg></div></div>}
{kind === 'statlink' && <div class="shot" aria-hidden="true"><div class="sb"><i></i><i></i><i></i><i></i><i></i></div><div class="ct"><div class="bar"></div><div class="cg"><div><b></b><i></i><i></i></div><div><b></b><i></i><i></i></div><div><b></b><i></i><i></i></div><div><b></b><i></i><i></i></div><div><b></b><i></i><i></i></div><div><b></b><i></i><i></i></div></div></div></div>}
