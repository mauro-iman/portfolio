---
import Case from '../../views/Case.astro';
import Project from '../../views/Project.astro';
import { cases, paged } from '../../lib/content.js';
export const getStaticPaths = () => [
  ...cases.map(c => ({ params: { slug: c.slug }, props: { c } })),
  ...paged.map(p => ({ params: { slug: p.slug }, props: { p } }))
];
const { c, p } = Astro.props;
---
{c ? <Case lang="en" c={c} /> : <Project lang="en" p={p} />}
