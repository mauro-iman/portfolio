---
/* Case study page (DESIGN.md › Page: Case study). Content comes from src/content/cases/<slug>.yaml. */
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import CoverMat from '../components/CoverMat.astro';
import Gallery from '../components/Gallery.astro';
import { dict, translator, url, nextOf } from '../lib/content.js';
import { img, fit } from '../lib/images.js';

const { lang, c } = Astro.props;
const D = dict(c), t = translator(D, lang), d = c[lang], nx = nextOf(c);
const minis = {
  q: '<div class="q"><i></i><span></span><em></em></div>'.repeat(4),
  notes: '<i></i>'.repeat(9),
  sys: '<i></i><i></i><i></i><i></i><b></b><u></u><s></s>'
};
---
<Base lang={lang} D={D} titleKey="c.doc" path={`work/${c.slug}/`} asm pageScripts={['case.js', 'gallery.js']}>
  <section class="c-hero" id="case-top" aria-labelledby="c-h1">
    <canvas class="fieldcv" id="fCase" aria-hidden="true"></canvas>
    <canvas class="c-asm" id="fAsm" aria-hidden="true"></canvas>
    <div class="hero-veil"></div>
    <div class="wrap c-hero-in">
      <a class="c-back" href={url(lang, '#work')} data-l="#work"><span aria-hidden="true">←</span><span data-i="c.back">{t('c.back')}</span></a>
      <div class="c-head">
        <p class="label" data-i="c.kicker">{t('c.kicker')}</p>
        <h1 id="c-h1" data-i={`case.${c.slug}.t`}>{c.title}</h1>
        <p class="lead" data-i={`case.${c.slug}.s`}>{t(`case.${c.slug}.s`)}</p>
        <dl class="c-facts">
          {['role', 'scope', 'team', 'time'].map(k => <div><dt class="label" data-i={`c.f.${k}`}>{t(`c.f.${k}`)}</dt><dd data-i={`c.f.${k}V`}>{t(`c.f.${k}V`)}</dd></div>)}
        </dl>
      </div>
    </div>
  </section>

  <section class="c-cover" aria-label={c.title}>
    <div class="wrap">
      <CoverMat c={c} t={t} cls="mat c-mat rv rise" feat eager altKey="c.cover" />
    </div>
  </section>

  <section class="sec" id="glance" aria-labelledby="glance-h">
    <div class="wrap"><div class="grid rv">
      <div class="side"><h2 class="label" id="glance-h" data-i="c.glance">{t('c.glance')}</h2></div>
      <div class="main">
        <div class="c-metrics">
          {d.metrics.map((m, i) => <div><b data-i={`c.mv${i + 1}`}>{m.value}</b><span data-i={`c.m${i + 1}`}>{m.label}</span></div>)}
        </div>
        <dl class="c-tldr">
          {[['p', 'c.q.p'], ['d', 'c.q.d'], ['r', 'c.q.r']].map(([k, key]) => <div><dt class="label" data-i={key}>{t(key)}</dt><dd data-i={`${key}V`}>{t(`${key}V`)}</dd></div>)}
        </dl>
      </div>
    </div></div>
  </section>

  <section class="sec" id="chapters" aria-labelledby="chap-h">
    <div class="wrap">
      <div class="grid rv">
        <div class="side"><span class="label" data-i="c.story">{t('c.story')}</span></div>
        <div class="main"><h2 class="c-h2" id="chap-h" data-i="c.story.h">{t('c.story.h')}</h2></div>
      </div>
      <div class="c-ch">
        <div class="c-ch-vis" aria-hidden="true">
          <div class="c-ch-panel" id="chPanel"><canvas class="fieldcv" id="fChap"></canvas><span class="label c-ch-state" id="chState" data-i="c.st0">{t('c.st0')}</span></div>
        </div>
        <div class="c-ch-text">
          <nav class="c-rail" aria-label={t('c.chapters')}>
            {[1, 2, 3].map(n => <a href={`#ch${n}`} aria-current={n === 1 ? 'step' : undefined}><span class="tilde" aria-hidden="true"></span><span data-i={`c.ch${n}`}>{t(`c.ch${n}`)}</span></a>)}
          </nav>
          {[1, 2, 3].map(n => (
            <section class={`c-step${n === 1 ? ' on' : ''}`} id={`ch${n}`} aria-labelledby={`ch${n}-h`}>
              <span class="label" data-i={`c.s${n}.k`}>{t(`c.s${n}.k`)}</span>
              <h3 id={`ch${n}-h`} data-i={`c.s${n}.h`}>{t(`c.s${n}.h`)}</h3>
              <p data-i={`c.s${n}.p`}>{t(`c.s${n}.p`)}</p>
              <span class="c-data" data-i={`c.s${n}.ph`}>{t(`c.s${n}.ph`)}</span>
            </section>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="sec" id="did" aria-labelledby="did-h">
    <div class="wrap"><div class="grid">
      <div class="side rv"><span class="label" data-i="c.did">{t('c.did')}</span></div>
      <div class="main">
        <h2 class="c-h2 rv" id="did-h" data-i="c.did.h">{t('c.did.h')}</h2>
        <div class={`c-work n${d.work.items.length}`}>
          {d.work.items.map((w, i) => { const src = img(c.slug, (c.workImages || [])[i]); return (
            <article class="c-ws rv">
              {src ? (
                <div class={`mat has-img fit-${fit(src)}`}><Image src={src} alt={t(`c.w${i + 1}.alt`)} data-ia={`c.w${i + 1}.alt`} widths={[400, 800]} sizes="(max-width: 760px) 90vw, 440px" format="webp" loading="lazy" decoding="async" /></div>
              ) : (
                <div class="mat"><div class={`mini${w.mini === 'q' ? '' : ' ' + w.mini}`} aria-hidden="true" set:html={minis[w.mini] || minis.q}></div><span class="label ph-tag" data-i={`c.w${i + 1}.ph`}>{w.screen}</span></div>
              )}
              <h3><span class="tilde" aria-hidden="true"></span><span data-i={`c.w${i + 1}.h`}>{w.title}</span></h3>
              <p data-i={`c.w${i + 1}.p`}>{w.text}</p>
            </article>
          ); })}
        </div>
      </div>
    </div></div>
  </section>

  {(c.screens?.length || c.phones?.length) ? <Gallery c={c} t={t} /> : null}

  {c.system && (
    <section class="sec" id="system" aria-labelledby="sys-h">
      <div class="wrap"><div class="grid rv">
        <div class="side"><span class="label" data-i="c.try">{t('c.try')}</span></div>
        <div class="main">
          <h2 class="c-h2" id="sys-h" data-i="c.try.h">{t('c.try.h')}</h2>
          <p class="c-next-p" data-i="c.try.p">{t('c.try.p')}</p>
          <div class="brand-demo">
            <div class="chips" id="bdChips" role="group" aria-labelledby="sys-h">
              <span class="tilde" id="bdTilde" aria-hidden="true"></span>
              {[1, 2, 3].map(n => <button type="button" aria-pressed={String(n === 1)} data-i={`c.b${n}`}>{t(`c.b${n}`)}</button>)}
            </div>
            <div class="bd-stage" id="bdStage" aria-hidden="true">
              <div class="bd-ui">
                <div class="bd-top"><span class="bd-logo"><i></i><span id="bdName" data-i="c.b1">{t('c.b1')}</span></span><span class="label" data-i="c.bd.home">{t('c.bd.home')}</span></div>
                <div class="bd-body">
                  <div class="bd-list">
                    {[1, 2, 3].map(n => <div class="bd-row"><span data-i={`c.bd.r${n}`}>{t(`c.bd.r${n}`)}</span><span class="bd-tag" data-i={`c.bd.t${n}`}>{t(`c.bd.t${n}`)}</span></div>)}
                  </div>
                  <div class="bd-side"><div class="bd-in" data-i="c.bd.in">{t('c.bd.in')}</div><div class="bd-btn" data-i="c.bd.btn">{t('c.bd.btn')}</div></div>
                </div>
              </div>
            </div>
            <p class="bd-note"><span data-i="c.bd.note">{t('c.bd.note')}</span> <span class="vh" id="bdLive" role="status"></span></p>
          </div>
        </div>
      </div></div>
    </section>
  )}

  <section class="sec" id="reflect" aria-labelledby="ref-h">
    <div class="wrap"><div class="grid rv">
      <div class="side"><h2 class="label" id="ref-h" data-i="c.ref">{t('c.ref')}</h2></div>
      <div class="main">
        <blockquote class="c-quote"><p class="ph" style="margin:0" data-i="c.ref.q">{t('c.ref.q')}</p></blockquote>
        <p class="c-next-p" data-i="c.ref.next">{t('c.ref.next')}</p>
      </div>
    </div></div>
  </section>

  <section class="sec" id="next" aria-label={t('c.nextAria')}>
    <div class="wrap">
      <a class="c-next rv" id="cNext" href={url(lang, `work/${nx.slug}/`)} data-l={`work/${nx.slug}/`}>
        <canvas class="fieldcv" id="fNext" aria-hidden="true"></canvas>
        <div class="c-next-in">
          <span class="label" data-i="c.next">{t('c.next')}</span>
          <h2><span data-i={`case.${nx.slug}.t`}>{nx.title}</span><span class="arr" aria-hidden="true">→</span></h2>
          <p data-i={`case.${nx.slug}.s`}>{t(`case.${nx.slug}.s`)}</p>
        </div>
      </a>
    </div>
  </section>
</Base>
