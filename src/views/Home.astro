---
import Base from '../layouts/Base.astro';
import CoverMat from '../components/CoverMat.astro';
import { site, cases, building, more, dict, translator, url } from '../lib/content.js';

const { lang } = Astro.props;
const D = dict(), t = translator(D, lang);
const minis = {
  q: '<div class="q"><i></i><span></span><em></em></div>'.repeat(4),
  notes: '<i></i>'.repeat(9),
  sys: '<i></i><i></i><i></i><i></i><b></b><u></u><s></s>'
};
---
<Base lang={lang} D={D} titleKey="doc.home" home>
  <section class="hero" id="home" aria-labelledby="h1">
    <canvas class="fieldcv" id="fHero" aria-hidden="true"></canvas>
    <canvas class="fieldcv" id="fHeroP" aria-hidden="true"></canvas>
    <div class="hero-veil"></div>
    <div class="wrap">
      <p class="gloss" data-ih="hero.gloss" set:html={t('hero.gloss')}></p>
      <h1 id="h1" data-i="hero.h1">{t('hero.h1')}</h1>
      <p class="lead" data-i="hero.lead">{t('hero.lead')}</p>
      <div class="ctas">
        <a class="btn-p" href="#work" data-mag><span data-i="hero.cta1">{t('hero.cta1')}</span><span class="tilde" aria-hidden="true"></span></a>
        <button type="button" class="btn-s" data-hl data-mag><span data-i="hero.cta2">{t('hero.cta2')}</span></button>
      </div>
      <div class="meta"><span class="label" data-i="hero.loc">{t('hero.loc')}</span><span class="label" data-i="hero.avail">{t('hero.avail')}</span></div>
    </div>
  </section>

  <section class="sec" id="work" aria-labelledby="work-h">
    <div class="work-head">
      <canvas class="work-field" id="fWork" aria-hidden="true"></canvas>
      <div class="wrap"><div class="grid rv">
        <div class="side"><span class="label" data-i="work.label">{t('work.label')}</span></div>
        <div class="main"><h2 id="work-h" data-i="work.h2">{t('work.h2')}</h2></div>
      </div></div>
    </div>
    <div class="wrap">
      <div class="cases">
        {cases.map((c, i) => (
          <article class={`case rv${i === 0 ? ' feat' : ''}`}>
            <a class="case-link" href={url(lang, `work/${c.slug}/`)} data-l={`work/${c.slug}/`} data-case>
              <CoverMat c={c} t={t} feat={i === 0} />
              <div class="case-meta">
                <span class="label case-k" data-i={`case.${c.slug}.k`}>{t(`case.${c.slug}.k`)}</span>
                <h3 data-i={`case.${c.slug}.t`}>{c.title}</h3>
                <p data-i={`case.${c.slug}.s`}>{t(`case.${c.slug}.s`)}</p>
                <div class="metric"><b>{c.homeMetric}</b><span data-i={`case.${c.slug}.m`}>{t(`case.${c.slug}.m`)}</span></div>
                <span class="read" data-i="case.read">{t('case.read')}</span>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="sec" id="building" aria-labelledby="bld-h">
    <div class="wrap">
      <div class="grid rv">
        <div class="side"><span class="label" data-i="bld.label">{t('bld.label')}</span></div>
        <div class="main">
          <h2 id="bld-h" data-i="bld.h2">{t('bld.h2')}</h2>
          <p class="sub" data-i="bld.sub">{t('bld.sub')}</p>
        </div>
      </div>
      <div class="bld">
        {building.map(p => (
          <article class="case rv">
            <a class="case-link" href={url(lang, `work/${p.slug}/`)} data-l={`work/${p.slug}/`}>
              {p.coverImage ? <CoverMat c={p} t={t} /> : (
                <div class="mat"><div class={`mini${p.mini && p.mini !== 'q' ? ' ' + p.mini : ''}`} aria-hidden="true" set:html={minis[p.mini] || minis.q}></div><span class="label ph-tag" data-i="mat.ph">{t('mat.ph')}</span></div>
              )}
              <div class="case-meta">
                <span class="label case-k" data-i={`proj.${p.slug}.k`}>{t(`proj.${p.slug}.k`)}</span>
                <h3 data-i={`proj.${p.slug}.t`}>{p.title}</h3>
                <p data-i={`proj.${p.slug}.s`}>{t(`proj.${p.slug}.s`)}</p>
                <span class="label bld-role" data-i={`proj.${p.slug}.r`}>{t(`proj.${p.slug}.r`)}</span>
                <span class="read" data-i="bld.read">{t('bld.read')}</span>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="sec" id="more" aria-labelledby="more-h">
    <div class="wrap">
      <div class="grid rv">
        <div class="side"><span class="label" data-i="more.label">{t('more.label')}</span></div>
        <div class="main">
          <h2 class="more-h" id="more-h" data-i="more.h2">{t('more.h2')}</h2>
          <ul class="archive">
            {more.map(p => (
              <li>{p.group === 'list'
                ? <span class="arch-i"><b>{p.title}</b><span class="label" data-i={`proj.${p.slug}.k`}>{t(`proj.${p.slug}.k`)}</span></span>
                : <a href={url(lang, `work/${p.slug}/`)} data-l={`work/${p.slug}/`}><b>{p.title}</b><span class="label" data-i={`proj.${p.slug}.k`}>{t(`proj.${p.slug}.k`)}</span></a>}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="sec" id="highlights" aria-labelledby="hl-h">
    <div class="wrap">
      <div class="hlb rv">
        <canvas class="fieldcv" id="fHl" aria-hidden="true"></canvas>
        <div class="hlb-in">
          <span class="label" data-i="hl.label">{t('hl.label')}</span>
          <h2 id="hl-h" data-i="hl.h">{t('hl.h')}</h2>
          <button type="button" class="btn-p" data-hl data-mag><span class="tilde" aria-hidden="true"></span><span data-i="hl.btn">{t('hl.btn')}</span><small>60 s</small></button>
        </div>
      </div>
    </div>
  </section>

  <section class="sec" id="about" aria-labelledby="cap-h">
    <div class="wrap">
      <div class="grid rv">
        <div class="side"><span class="label" data-i="cap.label">{t('cap.label')}</span></div>
        <div class="main">
          <h2 id="cap-h" data-i="cap.h2">{t('cap.h2')}</h2>
          <p class="sub" data-i="cap.sub">{t('cap.sub')}</p>
          <div class="caps">
            {[1, 2, 3].map(n => <div class="cap"><h3><span class="tilde" aria-hidden="true"></span><span data-i={`cap.${n}.t`}>{t(`cap.${n}.t`)}</span></h3><p data-i={`cap.${n}.p`}>{t(`cap.${n}.p`)}</p></div>)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="teams-h">
    <div class="wrap">
      <div class="grid rv">
        <div class="side"><h2 class="label" id="teams-h" data-i="teams.label">{t('teams.label')}</h2></div>
        <div class="main">
          <ul class="teams">{site.teams.map(n => <li>{n}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="about-h">
    <div class="wrap">
      <div class="grid about-g rv">
        <div class="portrait" aria-hidden="true"><span class="tilde"></span><span class="label" data-i="portrait">{t('portrait')}</span></div>
        <div class="about-t">
          <h2 id="about-h" data-i="about.h">{t('about.h')}</h2>
          <p data-i="about.p">{t('about.p')}</p>
          <a class="btn-s" href={site.linkedin} rel="me noopener" target="_blank" data-mag><span>LinkedIn</span></a>
        </div>
      </div>
    </div>
  </section>
</Base>
